# Where the learner roster is recorded. Leave both blank and the app runs
# entirely on the device: the name is asked for and kept locally, but nothing
# is sent anywhere.
#
# Both values are public — they ship inside the JS bundle. What protects the
# table is its row-level security policy, which allows inserts and nothing
# else. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
