{
  "name": "oma-suomi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Oma Suomi - a personal Finnish learning PWA (Finnish / English / Tagalog)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:situations": "node scripts/validate-situations.mjs",
    "validate": "npm run validate:data && npm run validate:situations"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
